{
    /******************************************************************************
            有各种写入数据的时机，请把握好时机，尤其是写DLL的时候，有时候DLL没加载，
            插件会自动加载，但是加载不上就需要自身判断时机了

                格式说明
        “模块名称(例如tdxw.exe,RibbonBar.dll)”: 
        [
                修改数据的数组{
                "rva":"0x123456",   这个是偏移地址(不是绝对地址)，十六进制文本

                "bytes":"010203",   十六进制补丁数值文本,可带空格，例如 02 0F

                "type":2,           整数型,写入补丁的时机
                                    1 = OEP，即Winmain函数之前,软件刚打开的时候
                                    2 = 登录窗口刚创建的时候(创建，还没显示出来)
                                    3 = 行情窗口出来后

                "loop":false        逻辑型，即是否循环写入，对type=0的无效
                                    true = 循环写入数据，false = 只写一次

                "mark":"修改L2数据"  备注,可不写
                }
        ]
        
    *******************************************************************************/
    "TdxW.exe": [




    ]

}